lib cfg = "save/config.ssz";

//Load "lib/" Scripts
lib file = <file.ssz>;
lib sh = <shell.ssz>;
lib s = <string.ssz>;

//Load "lib/alpha/" Scripts
lib lua = <alpha/lua.ssz>;

//Open Game Executable
sh.open(.cfg.Executable, "ssz/ikemen.ssz", "", false, true);
const ^/char licensefile = "LICENSE.txt";
if(#file.find(licensefile) == 0 || #file.find(licensefile) == 1){
	&file.File f;
	f.open(licensefile, "wb");
	f.writeAry!ubyte?()<, s.sToU8(
\xfeff
