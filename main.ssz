////////////////////
//BACKUP DATA FILES
////////////////////

//Stats Data
const ^/char statsfile = "save/stats_sav.json";
if(#file.find(statsfile) == 0){
	&file.File f;
	f.open(statsfile, "wb");
	f.writeAry!ubyte?()<, s.sToU8(
\xfeff
"{}"
	);
}

